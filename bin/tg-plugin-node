#!/bin/sh
# Runs a stolik script with the right node (plan P3). plugin/.mcp.json and plugin/hooks/hooks.json call this instead
# of a bare `node`: hooks run with a minimal environment, and the asdf shim is not on that PATH.
# Order: nodePath in ~/.config/stolik/config.json (the node that ran `stolik setup`), then node on PATH.
# Usage: tg-plugin-node <script.js> [args...]
set -eu

case "${XDG_CONFIG_HOME:-}" in
  /*) base="$XDG_CONFIG_HOME" ;;
  *) base="$HOME/.config" ;;
esac
cfg="$base/stolik/config.json"

node=""
if [ -r "$cfg" ]; then
  node="$(sed -n 's/.*"nodePath"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$cfg" | head -n 1)"
fi
if [ -z "$node" ] || [ ! -x "$node" ]; then
  node="$(command -v node 2>/dev/null || true)"
fi
if [ -z "$node" ]; then
  echo "tg-plugin-node: no node found (set nodePath with: stolik setup)" >&2
  exit 1
fi
exec "$node" "$@"
