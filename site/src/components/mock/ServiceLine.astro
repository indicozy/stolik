---
interface Props {
  hidden?: boolean;
}
---
<li class="tgm-service" {...Astro.props}><slot /></li>
<style>
  .tgm-service {
    align-self: center;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--tg-in) 70%, transparent);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
  }
</style>
