---
interface Props {
  id: string;
  eyebrow: string;
  index?: string;
  title: string;
  lede?: string;
  align?: 'left' | 'center';
  width?: 'page' | 'narrow';
  first?: boolean;
}

const { id, eyebrow, index, title, lede, align = 'left', width = 'page', first = false } = Astro.props;
const titleId = `${id}-title`;
---
<section id={id} class:list={['td-section', { 'is-first': first, 'is-narrow': width === 'narrow' }]} aria-labelledby={titleId}>
  <div class="td-container">
    <header class:list={['td-section-head', { 'is-center': align === 'center' }]}>
      <p class="td-eyebrow td-rise" style="--i: 0">
        {index && <><span class="td-eyebrow-index">{index}</span><span class="td-eyebrow-sep"> / </span></>}
        <span class="td-eyebrow-text">{eyebrow}</span>
      </p>
      <h2 id={titleId} class="td-h1 td-rise" style="--i: 1">{title}</h2>
      {lede && <p class="td-lede td-rise" style="--i: 2">{lede}</p>}
    </header>
    <div class="td-section-content">
      <slot />
    </div>
  </div>
</section>
<style>
  .td-section {
    border-top: 1px solid var(--line);
    padding-block: var(--section-y);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .td-section.is-first { border-top: 0; }
  .td-section.is-narrow .td-container { max-width: var(--w-narrow); }
  .td-section-head { max-width: var(--w-prose); }
  .td-section-head.is-center { margin-inline: auto; text-align: center; }
  .td-section-head.is-center .td-lede { margin-inline: auto; }
  .td-eyebrow { color: var(--accent-2-text); }
  .td-eyebrow-index, .td-eyebrow-sep { color: var(--text-muted); }
  .td-section-head .td-h1 { margin-top: var(--sp-3); }
  .td-section-head .td-lede { margin-top: var(--sp-4); }
  .td-section-content { margin-top: var(--sp-12); }
</style>
