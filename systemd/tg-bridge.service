[Unit]
Description=tg-bridge Telegram router for Claude Code
# No After=: user units have no network-online.target. The router retries its own connections.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
# `tg-bridge service install` writes the real unit (service.ts renderSystemdUnit); this file is the reference copy.
# ExecStart: the absolute node path is needed (an asdf shim is not usable from systemd).
ExecStart=/usr/bin/env node %h/Documents/projects/tg-bridge/dist/router/main.js
Environment=DISPLAY=:0
Environment=PATH=%h/.asdf/shims:%h/.local/bin:/usr/local/bin:/usr/bin
# CPUAffinity and Nice apply to the router process only, not to tmux. The tmux server and the Claude Code sessions in it
# are started through systemd-run in their own scope (tmux.ts), so they keep the default CPU set and nice level.
CPUAffinity=8-19
Nice=19
# KillMode=process: restarting the router must not kill the tmux sessions or the Claude Code sessions in them. Only the
# router's main process gets the stop signal.
KillMode=process
Restart=always
RestartSec=3
# 78 is a config error and 75 means another router is running: restarting cannot fix either, so systemd stops retrying.
RestartPreventExitStatus=78 75

[Install]
WantedBy=default.target
