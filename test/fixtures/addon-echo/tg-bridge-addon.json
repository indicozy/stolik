{
  "name": "addon-echo",
  "version": "0.1.0",
  "protocol": 2,
  "command": ["node", "index.mjs"],
  "provides": [
    { "point": "media", "kinds": ["voice"] },
    { "point": "text-filter" },
    { "point": "prefix", "words": ["echo"] },
    { "point": "command", "name": "echo" },
    { "point": "router" },
    { "point": "schedule", "everyMinutes": 1 },
    { "point": "listener" }
  ],
  "access": ["message.text", "sessions.names"],
  "requires": []
}
